from datetime import datetime
from extensions import db, login_manager
from flask_login import UserMixin
import enum

class RoleEnum(enum.Enum):
    TRAVELER = "traveler"
    BUSINESS = "business"
    ADMIN = "admin"

class User(db.Model, UserMixin):
    id = db.Column(db.Integer, primary_key=True)
    email = db.Column(db.String(120), unique=True, nullable=False)
    name = db.Column(db.String(120))
    password_hash = db.Column(db.String(128))  # in a real app, use werkzeug.generate_password_hash
    role = db.Column(db.Enum(RoleEnum), default=RoleEnum.TRAVELER)
    created_at = db.Column(db.DateTime, default=datetime.utcnow)
    bookings = db.relationship("Booking", backref="user", lazy=True)

    def is_admin(self):
        return self.role == RoleEnum.ADMIN

@login_manager.user_loader
def load_user(user_id):
    return User.query.get(int(user_id))


class Vehicle(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    provider = db.Column(db.String(120))  # owner business or user
    brand = db.Column(db.String(80))
    model = db.Column(db.String(80))
    color = db.Column(db.String(30))
    vehicle_type = db.Column(db.String(50))  # e.g., SUV, sedan
    seats = db.Column(db.Integer)
    mpg = db.Column(db.Float)
    price_per_day = db.Column(db.Float, nullable=False)
    available = db.Column(db.Boolean, default=True)
    location = db.Column(db.String(120))
    description = db.Column(db.Text)
    created_at = db.Column(db.DateTime, default=datetime.utcnow)
    bookings = db.relationship("Booking", backref="vehicle", lazy=True)


class BookingStatusEnum(enum.Enum):
    PENDING = "pending"
    CONFIRMED = "confirmed"
    CANCELLED = "cancelled"

class Booking(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    user_id = db.Column(db.Integer, db.ForeignKey("user.id"))
    vehicle_id = db.Column(db.Integer, db.ForeignKey("vehicle.id"))
    pickup_location = db.Column(db.String(120))
    dropoff_location = db.Column(db.String(120))
    start_date = db.Column(db.Date)
    end_date = db.Column(db.Date)
    total_price = db.Column(db.Float)
    status = db.Column(db.Enum(BookingStatusEnum), default=BookingStatusEnum.PENDING)
    created_at = db.Column(db.DateTime, default=datetime.utcnow)
    stripe_payment_intent = db.Column(db.String(255), nullable=True)
